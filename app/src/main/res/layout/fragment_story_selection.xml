<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/imageMamouth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backgroundmammouth" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/buttonStory1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="La moumoute du mammouth Helmouth"
            android:backgroundTint="#A3D5FF"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonStory2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Le dessin de Helmouth"
            android:backgroundTint="#FFA3F6"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonStory3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Le mamouth Helmouth joue au fouth"
            android:backgroundTint="#81C784"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonStory4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Helmouth a perdu sa confiance"
            android:backgroundTint="#F4A300"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retour"
            android:backgroundTint="#CCCCCC"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="200dp"
            android:minHeight="50dp" />
    </LinearLayout>
</FrameLayout>
