<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundmammouth2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#E6FFFFFF"
        android:layout_margin="24dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/questionTextComp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <GridLayout
            android:id="@+id/optionsGridComp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignBounds"
            android:layout_marginBottom="24dp"
            android:useDefaultMargins="true">

            <!-- Option A -->
            <LinearLayout android:id="@+id/optionLayoutA_Comp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_option_rounded" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <ImageView android:id="@+id/optionIconA_Comp" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginBottom="8dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/optionTextA_Comp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="#000000" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Option B -->
            <LinearLayout android:id="@+id/optionLayoutB_Comp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_option_rounded" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <ImageView android:id="@+id/optionIconB_Comp" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginBottom="8dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/optionTextB_Comp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="#000000" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Option C -->
            <LinearLayout android:id="@+id/optionLayoutC_Comp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_option_rounded" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <ImageView android:id="@+id/optionIconC_Comp" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginBottom="8dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/optionTextC_Comp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="#000000" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Option D -->
            <LinearLayout android:id="@+id/optionLayoutD_Comp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_option_rounded" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <ImageView android:id="@+id/optionIconD_Comp" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginBottom="8dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/optionTextD_Comp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="#000000" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Option E -->
            <LinearLayout android:id="@+id/optionLayoutE_Comp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_option_rounded" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <ImageView android:id="@+id/optionIconE_Comp" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginBottom="8dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/optionTextE_Comp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="#000000" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Option F -->
            <LinearLayout android:id="@+id/optionLayoutF_Comp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_option_rounded" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <ImageView android:id="@+id/optionIconF_Comp" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginBottom="8dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/optionTextF_Comp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="#000000" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
        </GridLayout>

    </LinearLayout>
</ScrollView>
