<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backgroundmammouth2" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/buttonStory1WithEmotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="La moumoute du mammouth  Helmouth    ( Avec Emotion )"
            android:backgroundTint="#A3D5FF"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonStory2NoEmotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Le dessin d’Helmouth            ( Sans Emotion )"
            android:backgroundTint="#FFA3F6"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retour"
            android:backgroundTint="#CCCCCC"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="200dp"
            android:minHeight="50dp" />

    </LinearLayout>
</FrameLayout>
