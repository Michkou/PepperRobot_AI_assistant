<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/imageBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backgroundmammouth2" />

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/buttonStory1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="La moumoute du mammouth Helmouth"
            android:backgroundTint="#FFD700"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonStory2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Le dessin de Helmouth"
            android:backgroundTint="#F4A300"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonStory3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Le mamouth Helmouth joue au fouth"
            android:backgroundTint="#FFD700"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonStory4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Helmouth a perdu sa confiance"
            android:backgroundTint="#F4A300"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="300dp"
            android:minHeight="60dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retour"
            android:backgroundTint="#CCCCCC"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="200dp"
            android:minHeight="50dp" />

    </LinearLayout>

</FrameLayout>
