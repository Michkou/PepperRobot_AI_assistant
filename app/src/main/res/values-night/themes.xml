<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PepperRobotAIassistant" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/earth_brown_light</item>
        <item name="colorPrimaryVariant">@color/earth_brown_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/sun_yellow</item>
        <item name="colorSecondaryVariant">@color/sun_yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Style global des boutons (optionnel) -->
        <item name="materialButtonStyle">@style/Widget.PepperRobotAIassistant.Button</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.PepperRobotAIassistant.Fullscreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>
</resources>